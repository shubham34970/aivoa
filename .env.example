# ==============================================================================
# AIVOA Pharma QMS - Environment Configuration Template
# ==============================================================================

# Groq LLM API Configuration
# Sign up and generate a free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=gemma2-9b-it
FALLBACK_MODEL=llama-3.3-70b-versatile

# Backend Database URL
# SQLite default: sqlite:///./pharma_qms.db
# PostgreSQL: postgresql://username:password@localhost:5432/pharma_qms
DATABASE_URL=sqlite:///./pharma_qms.db

# Live Deployed Backend & Vercel Configuration
BACKEND_URL=https://aivoa-rbn6.vercel.app
VITE_API_URL=https://aivoa-rbn6.vercel.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,https://aivoa-rbn6.vercel.app,*

# Backend Service
PORT=8000
HOST=127.0.0.1
